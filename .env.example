# Perkasa Motors — environment variable template.
# Copy to .env.local for local development. Never commit .env* with real values.
#
# PHASE 2B: a dedicated Supabase project ("Perkasa Motors Website") is live
# with the full schema applied and a development seed loaded. The public
# vehicle read path (lib/data/vehicles.ts) reads from it; admin functions
# still read lib/mock/ pending admin auth. Get your own values from the
# Supabase dashboard (Project Settings → API) — never copy real values into
# this file, only .env.local, which is git-ignored.

# Public site origin, used for canonical URLs / OG tags / sitemap. The app
# code falls back to the live Netlify URL below if this is unset, but set it
# explicitly in each environment (Netlify dashboard for production) so a
# future custom domain is a one-line env change, not a code change.
NEXT_PUBLIC_SITE_URL=https://webperkasamotors.netlify.app

# Supabase project URL (safe to expose to the client).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (safe to expose to the client — Row Level
# Security is the actual access boundary, not secrecy of this key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key. SERVER-SIDE USE ONLY.
# Never prefix this with NEXT_PUBLIC_. Never import it from a Client
# Component. It bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=
