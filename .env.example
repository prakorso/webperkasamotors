# Perkasa Motors — environment variable template.
# Copy to .env.local for local development. Never commit .env* with real values.
#
# PHASE 1: none of these are configured with real values yet — Supabase
# is not connected. This file exists to document the shape Phase 2 expects.

# Public site origin, used for canonical URLs / OG tags / sitemap. No
# production domain exists yet — set this once one does.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (safe to expose to the client).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable/anon key (safe to expose to the client — Row Level
# Security is the actual access boundary, not secrecy of this key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key. SERVER-SIDE USE ONLY.
# Never prefix this with NEXT_PUBLIC_. Never import it from a Client
# Component. It bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=
